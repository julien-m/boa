{
	"name": "boa",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "vitest run",
		"verify": "bun run check && bun run build && bun run test",
		"mac:build": "tauri build --bundles app",
		"test:ui": "bun scripts/ui-smoke.ts",
		"check:public": "bun scripts/check-public.ts"
	},
	"dependencies": {
		"@crabnebula/tauri-plugin-drag": "^2.1.0",
		"@monaco-editor/react": "^4.7.0",
		"@tanstack/react-query": "^5.104.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-deep-link": "^2.6.2",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"i18next": "^26.4.7",
		"lucide-react": "^1.57.0",
		"monaco-editor": "^0.57.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-error-boundary": "^6.1.6",
		"react-i18next": "^17.0.19",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.1",
		"@tauri-apps/cli": "^2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.2",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.5"
	},
	"license": "MIT",
	"description": "A local macOS cockpit for projects, files and Git review.",
	"repository": {
		"type": "git",
		"url": "https://github.com/julien-m/boa.git"
	},
	"engines": {
		"bun": ">=1.3.9"
	},
	"packageManager": "bun@1.3.9",
	"bin": {
		"boa": "scripts/boa.ts"
	}
}
