{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOA",
  "version": "0.1.0",
  "identifier": "com.julienm.boa",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BOA — Projets & Git",
        "width": 1440,
        "height": 940,
        "minWidth": 880,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data: asset: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["boa"] } } },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
